name: ewars_plus_template

target: disease_cases
required_covariates:
  - population
supported_period_type: any
allow_free_additional_continuous_covariates: true
user_options:
  candidate_lags:
    type: array
    items:
      type: integer
    default: [7, 10, 12]
    description: Candidate lags considered during per-district lag selection. The selected lag with the highest mean expanding-window CV log-score across districts is used for each covariate. Set n_lags to bypass selection.
  lag_selection_cv_folds:
    type: integer
    default: 3
    description: Number of expanding-window CV folds used during lag selection.
  n_lags:
    type: array
    items:
      type: integer
    default: []
    description: Manual override. If set, lag selection is skipped and these lags are used directly (one value per covariate, or a single value applied to all).
  precision:
    type: number
    default: 0.01
    description: Prior precision on fixed effects.
  region_seasonal:
    type: boolean
    default: false
    description: Optional region-specific seasonal effect.

meta_data:
  display_name: CHAP-EWARS-Plus Model
  description: >
    Bayesian hierarchical INLA model for case counts with adaptive
    per-district selection of climate-covariate lags. A clean
    re-implementation of the central ideas in the ewars_Plus model.
  author: CHAP team
  author_assessed_status: orange
  organization: HISP Centre, University of Oslo
  organization_logo_url: https://landportal.org/sites/default/files/2024-03/university_of_oslo_logo.png
  contact_email: knut.rand@dhis2.org
  citation_info: >
    Climate Health Analytics Platform. 2026. "CHAP-EWARS-Plus model".
    HISP Centre, University of Oslo.

adapters: {'Cases': 'disease_cases',
           'E': 'population',
           'month': 'month',
           'week': 'week',
           'ID_year': 'year',
           'ID_spat': 'location',
           }

docker_env:
  image: ghcr.io/dhis2-chap/docker_r_inla:master

entry_points:
  train:
    parameters:
      train_data: path
      model: str
      model_config: path
    command: "Rscript train.R {train_data} {model} {model_config}"
  predict:
    parameters:
      historic_data: path
      future_data: path
      model: str
      out_file: path
      model_config: path
    command: "Rscript predict.R {model} {historic_data} {future_data} {out_file} {model_config}"
